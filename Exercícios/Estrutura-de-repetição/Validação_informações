# Faça um programa que leia e valide as seguintes informações: 
# Nome: maior que 3 caracteres:
# Idade: entre 0 e 150
# Salário: maior que 0
# Sexo: 'f' ou 'm'
# Estado Civil: "S" 'C','V' ou 'D'

while True:
    nome = input('Digite seu nome:')
    idade = int(input('Digite sua idade:'))
    salario = float(input('Digite seu salario:'))
    sexo = input('Digite seu sexo: m ou f ').lower()
    estadoCivil =input('Digite seu estado civil:')

    if len(nome) <= 3 or (idade < 0 or idade > 150) or salario <= 0 or sexo.lower() not in ('f','m') or estadoCivil not in ('s', 'c', 'v','d'):
        print('Dados invalido, tente novamente')
        continue
    break



    
